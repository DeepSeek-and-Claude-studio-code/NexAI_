{
  "name": "nex-desktop",
  "productName": "Nex",
  "version": "1.5.0",
  "description": "Nex AI Agent & Desktop Companion for Windows and Linux",
  "main": "src/main.js",
  "author": "Nex",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.nex.assistant.desktop",
    "productName": "Nex",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "linux": {
      "icon": "assets/icons",
      "category": "Utility",
      "maintainer": "Nex <nex@local>",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "Nex",
          "Comment": "Nex AI Agent & Desktop Companion",
          "StartupWMClass": "nex-desktop",
          "StartupNotify": "true",
          "Categories": "Utility;"
        }
      },
      "target": [
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Nex-${version}-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "../nex-code",
        "to": "nex-code",
        "filter": [
          "**/*",
          "!node_modules/**"
        ]
      }
    ]
  },
  "homepage": "https://github.com/DeepSeek-and-Claude-studio-code/NexAI_",
  "desktopName": "nex-desktop.desktop"
}
